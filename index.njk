<style>
  .home-hero { padding: 96px 0 80px; }
  .home-hero h1 {
    font-size: clamp(38px, 4.6vw, 50px);
    font-weight: 700; line-height: 1.08; letter-spacing: -0.025em;
    margin: 24px 0 16px; max-width: 24ch;
  }
  .home-hero h1 .accent { color: var(--color-accent-vivid); }
  .home-hero .positioning {
    font-size: 17px; font-weight: 600; color: var(--fg-1);
    line-height: 1.45; letter-spacing: -0.01em;
    max-width: 560px; margin: 0 0 18px;
  }
  .home-hero .lede {
    font-size: 19px; line-height: 1.6; color: var(--fg-2);
    max-width: 580px; margin: 0 0 32px;
  }
  .home-hero .ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .home-hero .hero-writing { margin: 14px 0 0; font-size: 14px; }
  .home-hero .hero-writing a { color: var(--fg-2); text-decoration: none; font-weight: 500; }
  .home-hero .hero-writing a:hover { color: var(--color-accent-vivid); text-decoration: underline; text-underline-offset: 3px; }
  .proof-strip { display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center; padding: 22px 26px; background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); text-decoration: none; transition: border-color var(--dur-fast); }
  .proof-strip:hover { border-color: rgba(0,230,118,0.4); }
  .proof-metric { font-size: 26px; font-weight: 700; color: #FFF; white-space: nowrap; letter-spacing: -0.01em; line-height: 1.1; }
  .proof-metric .pa { color: var(--fg-3); margin: 0 2px; }
  .proof-metric small { display: block; font-size: 13px; font-weight: 400; color: var(--fg-3); letter-spacing: 0; margin-top: 6px; }
  .proof-copy { font-size: 14px; color: var(--fg-2); line-height: 1.6; }
  .proof-go { font-size: 13px; font-weight: 600; color: var(--fg-1); white-space: nowrap; }
  .proof-strip:hover .proof-go { color: var(--color-accent-vivid); }
  @media (max-width: 680px) { .proof-strip { grid-template-columns: 1fr; gap: 14px; } .proof-go { justify-self: start; } }

  /* Headshot frame */
  .headshot-frame {
    position: relative; aspect-ratio: 3/4;
    border-radius: 14px;
    background: linear-gradient(135deg, #0F172A 0%, #0A2540 60%, #050B17 100%);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }
  .headshot-frame img {
    width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block;
  }
  .home-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: center; }

  /* Stats strip */
  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: var(--border-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-top: 64px;
  }
  .stats .stat { background: var(--bg-base); padding: 28px 24px; }
  .stats .stat.key .l { color: var(--fg-1); }
  .stats .v {
    font-size: 38px; font-weight: 700; line-height: 1;
    letter-spacing: -0.01em; color: #FFF; font-variant-numeric: tabular-nums;
    display: flex; align-items: baseline; gap: 6px;
  }
  .stats .v small { font-size: 16px; font-weight: 500; color: var(--fg-2); }
  .stats .l { font-size: 14px; line-height: 1.45; color: var(--fg-2); margin-top: 12px; }

  /* Work with me */
  section.block { padding: 96px 0; }
  .also-links { display: flex; gap: 24px; margin: 18px 0 0; font-size: 14px; font-weight: 600; }
  .offer-note { margin: 28px 0 0; font-size: 14px; color: var(--fg-2); line-height: 1.9; }
  .offer-note a { color: var(--fg-1); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--border-strong); }
  .offer-note a:hover { color: var(--color-accent-vivid); border-bottom-color: var(--color-accent-vivid); }


  #work .page-wrap { position: relative; }
  #work .egg-link {
    position: absolute; top: 8px; right: 8px;
    font-family: var(--font-mono); font-size: 11px;
    color: var(--fg-3); opacity: 0.35;
    text-decoration: none; line-height: 1;
    transition: color var(--dur-fast) var(--ease-standard), opacity var(--dur-fast) var(--ease-standard);
  }
  #work .egg-link:hover { opacity: 1; color: var(--color-accent-vivid); cursor: pointer; }
  section.block .block-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; gap: 32px; flex-wrap: wrap; }
  section.block h2 { font-size: 38px; font-weight: 700; line-height: 1.1; letter-spacing: -0.01em; margin: 0; max-width: 600px; }
  section.block .block-sub { color: var(--fg-2); font-size: 15px; max-width: 480px; line-height: 1.6; margin-top: 12px; }

  /* Career: the current role leads, then earlier chapters newest first */
  .now-card { padding: 28px 30px; margin-bottom: 16px; border-color: rgba(0,230,118,0.4); }
  .now-card h3 { font-size: 24px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.25; margin: 0 0 10px; color: var(--fg-1); }
  .now-card p { font-size: 16px; color: var(--fg-2); line-height: 1.65; margin: 0; max-width: 680px; }
  .work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .work-card { padding: 24px; }
  .work-when {
    font-family: var(--font-mono); font-size: 13px; color: var(--fg-2);
    font-variant-numeric: tabular-nums; margin: 0 0 10px;
  }
  .work-when .is-now { color: var(--color-accent-vivid); }
  .work-card h3 { font-size: 17px; font-weight: 600; line-height: 1.35; margin: 0 0 4px; color: var(--fg-1); }
  .work-card .work-role { font-size: 14px; color: var(--fg-1); margin: 0 0 12px; }
  .work-card p { font-size: 14px; color: var(--fg-2); margin: 0; line-height: 1.6; }

  /* Experiments teaser: a compact list, deliberately lighter than the career */
  .tool-list { display: flex; flex-direction: column; border-top: 1px solid var(--border-subtle); }
  .tool-row {
    display: grid; grid-template-columns: 1fr auto 28px; gap: 24px; align-items: center;
    padding: 18px 0; border-bottom: 1px solid var(--border-subtle); text-decoration: none;
    transition: padding-left var(--dur-base) var(--ease-standard);
  }
  .tool-row:hover { padding-left: 12px; }
  .tool-row .title { display: block; font-size: 17px; font-weight: 500; color: var(--fg-1); }
  .tool-row .tagline { display: block; font-size: 14px; color: var(--fg-2); margin-top: 3px; line-height: 1.5; }
  .tool-row .time { font-family: var(--font-mono); font-size: 13px; color: var(--fg-3); white-space: nowrap; }
  .tool-row .arrow { color: var(--fg-3); transition: color var(--dur-fast); }
  .tool-row:hover .arrow { color: var(--color-accent-vivid); }
  .tool-row:focus-visible { outline-offset: 2px; }

  /* Writing teaser */
  .post-list { display: flex; flex-direction: column; }
  .post-row {
    display: grid; grid-template-columns: 88px 1fr 140px 28px;
    gap: 24px; padding: 20px 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: center; cursor: pointer; text-decoration: none;
    transition: padding-left var(--dur-base) var(--ease-standard);
  }
  .post-row:hover { padding-left: 12px; }
  .post-row .date { font-family: var(--font-mono); font-size: 11px; color: var(--fg-3); }
  .post-row .title { font-size: 17px; font-weight: 500; color: #FFF; }
  .post-row .title .read { font-size: 11px; color: var(--fg-3); margin-left: 10px; font-family: var(--font-mono); }
  .post-row .tag { font-size: 13px; color: var(--fg-3); text-align: right; }
  .post-row .arrow { color: var(--fg-3); transition: color var(--dur-fast); }
  .post-row:hover .arrow { color: var(--color-accent-vivid); }

  /* Podcast band */
  .podcast-grid { display: grid; grid-template-columns: 1fr 0.9fr; gap: 48px; align-items: center; }
  .podcast-plate {
    position: relative; border: 1px solid var(--border-subtle); border-radius: 14px;
    overflow: hidden; background: var(--bg-deep);
  }
  .podcast-plate img { width: 100%; height: auto; display: block; }
  .podcast-copy h2 { font-size: clamp(28px, 3.4vw, 38px); font-weight: 700; line-height: 1.12; letter-spacing: -0.01em; margin: 16px 0 14px; max-width: 16ch; }
  .podcast-copy .tagline { font-size: 16px; font-weight: 500; color: var(--fg-1); margin: 0 0 14px; }
  .podcast-copy p { font-size: 15px; color: var(--fg-2); line-height: 1.7; margin: 0 0 24px; max-width: 46ch; }

  @media (max-width: 900px) {
    .podcast-grid { grid-template-columns: 1fr; gap: 28px; }
    .home-grid { grid-template-columns: 1fr; }
    .headshot-frame { max-width: 320px; aspect-ratio: 3/4; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .work-grid { grid-template-columns: 1fr; }
    .now-card { padding: 24px; }
    .now-card h3 { font-size: 21px; }
    .tool-row { grid-template-columns: 1fr 28px; }
    .tool-row .time { display: none; }
    .post-row { grid-template-columns: 88px 1fr 28px; }
    .post-row .tag { display: none; }
  }
</style>
<script src="nav.js"></script>
</head>
<body class="bolt-os">

<a href="#main" class="skip-link">Skip to main content</a>

<site-header></site-header>

<main class="atmos" data-screen-label="01 home" id="main">
  <div class="page-wrap">
    <div class="home-hero">
      <div class="home-grid">
        <div>
          <h1>I helped creators build careers when content was <span class="accent">still just a hobby.</span></h1>
          <p class="positioning">I build the products, and the commercial engine behind them, that turn an audience into a business. I've done it since 2008 across streaming, social commerce and creator platforms.</p>
          <p class="lede">I'm Jason Nellis. I was at Hulu when streaming was still a legal gray area, co-founded a company Facebook bought, launched Live Shopping and Super inside Meta, and stepped in as interim CEO at SuperBam. At BoltOS I lead innovation and go-to-market, selling creator intelligence to Premier League and Bundesliga clubs and global media brands. My best work happens where a product has to start paying for itself.</p>
          <div class="ctas">
            <a href="/blog#case-study" class="btn primary">Read the case studies</a>
            <a href="/contact" class="btn ghost">Get in touch</a>
          </div>
          <p class="hero-writing"><a href="https://linkedin.com/in/jasonnellis" class="tap" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">&#8599;</span></a></p>
        </div>
        <div class="headshot-frame">
          <img src="jason-headshot.jpg" alt="Jason Nellis" width="900" height="1200">
        </div>
      </div>

      <div class="stats">
        <div class="stat">
          <div class="v">2008</div>
          <div class="l">Building in media since</div>
        </div>
        <div class="stat key">
          <div class="v">2</div>
          <div class="l">Companies built and sold</div>
        </div>
        <div class="stat">
          <div class="v">25+</div>
          <div class="l">Launch partners for Facebook Live Shopping</div>
        </div>
        <div class="stat">
          <div class="v">5&times;</div>
          <div class="l">Qualified pipeline at BoltOS in six months</div>
        </div>
      </div>
    </div>
  </div>

  <!-- PROOF -->
  <section class="block" id="proof" style="padding-top: 32px; padding-bottom: 0">
    <div class="page-wrap">
      <a class="proof-strip" href="/blog/comedy-time-and-the-format-problem-at-hulu/">
        <span class="proof-metric">$400 <span class="pa">&rarr;</span> $4,000<small>Monthly revenue, same content</small></span>
        <span class="proof-copy">At Hulu, repackaging an existing comedy library into themed compilations multiplied its monthly revenue tenfold. Same footage, different format.</span>
        <span class="proof-go">Read the case study &rarr;</span>
      </a>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <!-- ls -a -->
  <section class="block" id="work">
    <div class="page-wrap">
      <a href="/ascii" class="egg-link" tabindex="-1" aria-hidden="true">.</a>
      <div class="block-head">
        <div>
          <h2>Where I am now, and how I got here.</h2>
          <p class="block-sub">Nearly twenty years of building, mostly on things that didn't have a category yet.</p>
        </div>
        <a href="/about" class="btn ghost">Full career log
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <article class="card now-card">
        <p class="work-when">Apr 2026 – <span class="is-now">Present</span></p>
        <h3>BoltOS · Head of Innovation &amp; GTM</h3>
        <p>I lead innovation and go-to-market: the product and the commercial team that turn creator and brand relationships into revenue, selling creator intelligence to Premier League and Bundesliga clubs and global media brands.</p>
      </article>

      <div class="work-grid">
        <article class="card work-card">
          <p class="work-when">2023 – 2026</p>
          <h3>Jogg and SuperBam</h3>
          <p class="work-role">Chief product officer, then interim CEO</p>
          <p>Rebuilt Jogg's product process and cut cycle time from twelve weeks to four. At SuperBam, rebuilt the ingestion pipeline for roughly four times the throughput, then stepped into the interim CEO seat.</p>
        </article>

        <article class="card work-card">
          <p class="work-when">2017 – 2023</p>
          <h3>Packagd and Meta</h3>
          <p class="work-role">Co-founder, then product director</p>
          <p>Co-founded an influencer monetization startup that Facebook bought. Built Live Shopping's first managed partner program, then built and launched Super and became NPE's first Founder in Residence.</p>
        </article>

        <article class="card work-card">
          <p class="work-when">2013 – 2017</p>
          <h3>Overachiever Media and VIZIO</h3>
          <p class="work-role">Founder, then product marketing</p>
          <p>Founded a marketing studio, grew it to a four-person shop and sold it to Brllnt in 2016. Ran product marketing at VIZIO before leaving to co-found Packagd.</p>
        </article>

        <article class="card work-card">
          <p class="work-when">2008 – 2012</p>
          <h3>Hulu</h3>
          <p class="work-role">Technology, then content partnerships</p>
          <p>Managed content partnerships for accounts from the White House to NBCUniversal in the early years of streaming. It's where I learned how far a good idea is from a product people use.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- WRITING TEASER -->
  <section class="block" style="padding-top: 0">
    <div class="page-wrap">
      <div class="block-head">
        <div>
          <h2>Recent writing.</h2>
          <p class="block-sub">Thinking out loud about the creator economy, usually because something wasn't sitting right.</p>
        </div>
        <a href="/blog" class="btn ghost">All essays
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="post-list">
        {%- for essay in collections.recentEssays %}
        <a class="post-row" href="{{ essay.url }}">
          <span class="date">{{ essay.data.date | readableDate }}</span>
          <span class="title">{{ essay.data.title }}<span class="read">{{ essay.data.readTime }}</span></span>
          <span class="tag">{{ essay.data.category | capitalize }}</span>
          <span class="arrow">→</span>
        </a>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- TOOLS TEASER -->
  <section class="block" id="tools" style="padding-top: 0">
    <div class="page-wrap">
      <div class="block-head">
        <div>
          <h2>Play with the argument.</h2>
          <p class="block-sub">A year as a creator, the cost of a schedule, three questions before a deal.</p>
        </div>
        <a href="/experiments" class="btn ghost">All experiments
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="tool-list">
        {%- for tool in collections.tools %}
        <a class="tool-row" href="{{ tool.data.url }}">
          <span><span class="title">{{ tool.data.title }}</span><span class="tagline">{{ tool.data.tagline }}</span></span>
          <span class="time">{{ tool.data.time }}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- ALSO: SPEAKING AND ADVISORY -->
  <section class="block" id="work-with-me" style="padding-top: 0">
    <div class="page-wrap">
      <div class="block-head">
        <div>
          <h2>Also: speaking and advisory.</h2>
          <p class="block-sub">I keynote, moderate panels and run the occasional leadership workshop. I also take on a small number of advisory engagements with founders in media and creator businesses.</p>
          <p class="also-links"><a href="/speaking" class="bolt">Speaking &rarr;</a><a href="/advisory" class="bolt">Advisory &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- PODCAST -->
  <section class="block" id="podcast" style="padding-top: 0">
    <div class="page-wrap">
      <div class="podcast-grid">
        <a class="podcast-plate" href="/building-value" aria-label="Building Value — the podcast">
          <img src="building-value-header.jpg" alt="Building Value with Jason Nellis — How creative work becomes a business" width="1672" height="941">
        </a>
        <div class="podcast-copy">
          <h2>Building Value is coming back.</h2>
          <p class="tagline">How creative work becomes a business.</p>
          <p>A hundred-plus conversations with the operators, founders and creators turning creative work into businesses. It's back in Q4 2026. Leave your email and I'll tell you when the first new episode drops.</p>
          <form class="sub-form" action="https://app.kit.com/forms/9920578/subscriptions" method="post" target="_blank">
            <input type="email" name="email_address" placeholder="your@email.com" required class="sub-input" autocomplete="email" aria-label="Email address">
            <button type="submit" class="btn primary sub-btn">Get notified</button>
          </form>
          <p class="sub-note">Powered by Kit &middot; Unsubscribe anytime &middot; <a href="/building-value">Hear the back catalog</a></p>
        </div>
      </div>
    </div>
  </section>

</main>

<site-footer></site-footer>


</body>
</html>
