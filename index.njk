<style>
  .home-hero { padding: 96px 0 80px; }
  .home-hero h1 {
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 700; line-height: 1.0; letter-spacing: -0.025em;
    margin: 24px 0 24px; max-width: 14ch;
  }
  .home-hero h1 .accent { color: var(--color-accent-vivid); }
  .home-hero .lede {
    font-size: 19px; line-height: 1.6; color: var(--fg-2);
    max-width: 580px; margin: 0 0 32px;
  }
  .home-hero .ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }

  /* Headshot frame */
  .headshot-frame {
    position: relative; aspect-ratio: 3/4;
    border-radius: 14px;
    background: linear-gradient(135deg, #0F172A 0%, #0A2540 60%, #050B17 100%);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0,230,118,0.08);
  }
  .headshot-frame img {
    width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block;
  }
  .headshot-frame .corner {
    position: absolute; padding: 10px 12px; font-family: var(--font-mono);
    font-size: 9px; color: rgba(148,163,184,0.7); letter-spacing: 0.1em; text-transform: uppercase;
    z-index: 2;
  }
  .headshot-frame .corner.tl { top: 0; left: 0; }
  .headshot-frame .corner.br { bottom: 0; right: 0; color: var(--color-accent-vivid); text-align: right; }
  /* Scan line — purely decorative, echoes the bio page portrait treatment */
  .headshot-frame .scan {
    position: absolute; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, transparent, rgba(0,230,118,0.35), transparent);
    animation: scandown 7s linear infinite;
    z-index: 1; pointer-events: none;
  }
  @keyframes scandown {
    0%   { top: 0%; opacity: 0; }
    5%   { opacity: 1; }
    95%  { opacity: 0.6; }
    100% { top: 100%; opacity: 0; }
  }

  .home-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: center; }

  /* Stats strip */
  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: var(--border-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-top: 64px;
  }
  .stats .stat { background: var(--bg-base); padding: 28px 24px; }
  .stats .v {
    font-size: 38px; font-weight: 700; line-height: 1;
    letter-spacing: -0.01em; color: #FFF; font-variant-numeric: tabular-nums;
    display: flex; align-items: baseline; gap: 6px;
  }
  .stats .v small { font-size: 16px; font-weight: 500; color: var(--fg-2); }
  .stats .l { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-2); margin-top: 12px; }

  /* Selected work */
  section.block { padding: 96px 0; }

  #work .page-wrap { position: relative; }
  #work .egg-link {
    position: absolute; top: 8px; right: 8px;
    font-family: var(--font-mono); font-size: 11px;
    color: var(--fg-3); opacity: 0.35;
    text-decoration: none; line-height: 1;
    transition: color var(--dur-fast) var(--ease-standard), opacity var(--dur-fast) var(--ease-standard);
  }
  #work .egg-link:hover { opacity: 1; color: var(--color-accent-vivid); cursor: pointer; }
  section.block .block-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; gap: 32px; flex-wrap: wrap; }
  section.block h2 { font-size: 38px; font-weight: 700; line-height: 1.1; letter-spacing: -0.01em; margin: 0; max-width: 600px; }
  section.block .block-sub { color: var(--fg-2); font-size: 15px; max-width: 480px; line-height: 1.6; margin-top: 12px; }

  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .work-card { position: relative; z-index: 0; overflow: hidden; padding: 24px; }
  .work-card .bg-num {
    position: absolute; top: -16px; right: -4px; z-index: -1;
    font-family: var(--font-mono); font-size: 88px; font-weight: 700;
    line-height: 1; letter-spacing: -0.04em; color: var(--fg-1); opacity: 0.05;
    pointer-events: none; user-select: none;
  }
  .work-card .ix { font-family: var(--font-mono); font-size: 11px; color: var(--fg-3); letter-spacing: 0.08em; margin-bottom: 10px; }
  .work-card .era { display: inline-block; font-size: 10px; font-family: var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2); border: 1px solid var(--border-strong); border-radius: 999px; padding: 3px 9px; margin-bottom: 14px; }
  .work-card h3 { font-size: 18px; font-weight: 500; line-height: 1.3; margin: 0 0 8px; color: #FFF; }
  .work-card p { font-size: 13px; color: var(--fg-2); margin: 0 0 18px; line-height: 1.6; }
  .work-card .meta { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--fg-3); padding-top: 14px; border-top: 1px solid var(--border-subtle); }
  .work-card .meta .role { color: var(--fg-1); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }

  /* Writing teaser */
  .post-list { display: flex; flex-direction: column; }
  .post-row {
    display: grid; grid-template-columns: 88px 1fr 140px 28px;
    gap: 24px; padding: 20px 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: center; cursor: pointer; text-decoration: none;
    transition: padding-left var(--dur-base) var(--ease-standard);
  }
  .post-row:hover { padding-left: 12px; }
  .post-row .date { font-family: var(--font-mono); font-size: 11px; color: var(--fg-3); letter-spacing: 0.08em; text-transform: uppercase; }
  .post-row .title { font-size: 17px; font-weight: 500; color: #FFF; }
  .post-row .title .read { font-size: 11px; color: var(--fg-3); margin-left: 10px; font-family: var(--font-mono); }
  .post-row .tag { font-size: 11px; color: var(--fg-3); text-transform: uppercase; letter-spacing: 0.08em; text-align: right; }
  .post-row .arrow { color: var(--fg-3); transition: color var(--dur-fast); }
  .post-row:hover .arrow { color: var(--color-accent-vivid); }

  @media (max-width: 900px) {
    .home-grid { grid-template-columns: 1fr; }
    .headshot-frame { max-width: 320px; aspect-ratio: 3/4; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .work-grid { grid-template-columns: 1fr; }
    .post-row { grid-template-columns: 80px 1fr 28px; }
    .post-row .tag { display: none; }
  }
</style>
<script src="nav.js"></script>
</head>
<body class="bolt-os">

<a href="#main" class="skip-link">Skip to main content</a>

<site-header></site-header>

<main class="atmos" data-screen-label="01 home" id="main">
  <div class="page-wrap">
    <div class="home-hero">
      <div class="home-grid">
        <div>
          <div class="section-eyebrow"><span class="num">01</span> Product Strategy &amp; Go-to-Market</div>
          <h1>Where strategy, story, and <span class="accent">systems</span> meet.</h1>
          <p class="lede">I'm Jason Nellis — a strategist, writer, and speaker who's been inside the creator economy since before it had a name — from early streaming to social commerce to AI-driven IP protection. I translate ambiguity into direction, and direction into things that actually ship.</p>
          <div class="ctas">
            <a href="/speaking" class="btn primary">Explore speaking topics</a>
            <a href="/blog" class="btn ghost">Read my writing</a>
          </div>
        </div>
        <div class="headshot-frame">
          <div class="corner tl">JN · 2026</div>
          <img src="jason-headshot.jpg" alt="Jason Nellis" width="900" height="1200">
          <div class="scan"></div>
          <div class="corner br">● Cannes, FR</div>
        </div>
      </div>

      <div class="stats">
        <div class="stat">
          <div class="v">20<small>+ yrs</small></div>
          <div class="l">Media &amp; creator economy</div>
        </div>
        <div class="stat">
          <div class="v">3</div>
          <div class="l">Companies co-founded</div>
        </div>
        <div class="stat">
          <div class="v">1</div>
          <div class="l">Acquired by Meta</div>
        </div>
        <div class="stat">
          <div class="v">2</div>
          <div class="l">Active ventures</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SELECTED WORK -->
  <!-- ls -a -->
  <section class="block" id="work">
    <div class="page-wrap">
      <a href="/ascii" class="egg-link" aria-label="hidden">.</a>
      <div class="block-head">
        <div>
          <div class="section-eyebrow"><span class="num">02</span> Selected work</div>
          <h2>The career, in three acts.</h2>
          <p class="block-sub">Twenty years of building from the inside — early streaming to social commerce to AI-driven IP protection.</p>
        </div>
        <a href="https://linkedin.com/in/jasonnellis" target="_blank" rel="noopener" class="btn ghost">LinkedIn ↗
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="work-grid">
        <article class="card work-card">
          <span class="bg-num">01</span>
          <div class="ix">001 / 2007 – 2012</div>
          <div class="era">Learning on the Go</div>
          <h3>Hulu — content &amp; product</h3>
          <p>Started in content partnerships — strategy for accounts from the White House to NBCUniversal — and moved into product and growth as streaming scaled. Learned the real distance between a good idea and a shippable one, and a permanent taste for building at scale.</p>
          <div class="meta">
            <span class="role">Content · Product</span>
            <span>Media · Streaming</span>
          </div>
        </article>

        <article class="card work-card">
          <span class="bg-num">02</span>
          <div class="ix">002 / 2016 – 2023</div>
          <div class="era">Acquired → Meta</div>
          <h3>Packagd — co-founder</h3>
          <p>Co-founded an influencer monetization startup, acquired by Facebook. Built Facebook Live Shopping inside NPE. Became Meta's first Founder in Residence.</p>
          <div class="meta">
            <span class="role">Co-Founder</span>
            <span>Social Commerce · Meta</span>
          </div>
        </article>

        <article class="card work-card">
          <span class="bg-num">03</span>
          <div class="ix">003 / 2023 – 2026</div>
          <div class="era">CPO → CEO</div>
          <h3>SuperBam — chief product officer</h3>
          <p>Built the product org from the ground up — creator IP protection, monetization infrastructure, an AI deepfake takedown system. Stepped in as Interim CEO in Q1 2026.</p>
          <div class="meta">
            <span class="role">CPO / CEO</span>
            <span>Creator Economy · IP</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- WRITING TEASER -->
  <section class="block" style="padding-top: 0">
    <div class="page-wrap">
      <div class="block-head">
        <div>
          <div class="section-eyebrow"><span class="num">03</span> Recent writing</div>
          <h2>Thinking out loud on strategy, story, and the creator economy.</h2>
        </div>
        <a href="/blog" class="btn ghost">All essays
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="post-list">
        {%- for essay in collections.recentEssays %}
        <a class="post-row" href="{{ essay.url }}">
          <span class="date">{{ essay.data.date | dotDate }}</span>
          <span class="title">{{ essay.data.title }}<span class="read">{{ essay.data.readTime }}</span></span>
          <span class="tag">{{ essay.data.category }}</span>
          <span class="arrow">→</span>
        </a>
        {%- endfor %}
      </div>

      <!-- NEWSLETTER -->
      <div class="subscribe-banner" style="margin: 48px 0 0">
        <div class="sub-content">
          <span class="sub-eyebrow">Newsletter</span>
          <p class="sub-headline">Get <em>The Long Yes</em> in your inbox.</p>
          <p class="sub-body">Strategy, media, and the creator economy &mdash; when I have something worth saying. Low frequency, no noise.</p>
          <form class="sub-form" action="https://jasonnellis.substack.com/api/v1/free" method="get" target="_blank">
            <input type="email" name="email" placeholder="your@email.com" required class="sub-input" autocomplete="email">
            <button type="submit" class="btn primary sub-btn">Subscribe</button>
          </form>
          <p class="sub-note">Powered by Substack &middot; Unsubscribe anytime</p>
        </div>
      </div>
    </div>
  </section>

</main>

<site-footer></site-footer>


</body>
</html>
