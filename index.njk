<style>
  .home-hero { padding: 96px 0 80px; }
  .home-hero h1 {
    font-size: clamp(38px, 4.6vw, 50px);
    font-weight: 700; line-height: 1.08; letter-spacing: -0.025em;
    margin: 24px 0 16px; max-width: 24ch;
  }
  .home-hero h1 .accent { color: var(--color-accent-vivid); }
  .home-hero .positioning {
    font-size: 17px; font-weight: 600; color: var(--fg-1);
    line-height: 1.45; letter-spacing: -0.01em;
    max-width: 560px; margin: 0 0 18px;
  }
  .home-hero .lede {
    font-size: 19px; line-height: 1.6; color: var(--fg-2);
    max-width: 580px; margin: 0 0 32px;
  }
  .home-hero .ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .home-hero .hero-writing { margin: 14px 0 0; font-size: 14px; }
  .home-hero .hero-writing a { color: var(--fg-2); text-decoration: none; font-weight: 500; }
  .home-hero .hero-writing a:hover { color: var(--color-accent-vivid); text-decoration: underline; text-underline-offset: 3px; }
  .proof-strip { display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center; padding: 22px 26px; background: var(--bg-card); border: 1px solid var(--border-subtle); border-left: 2px solid var(--color-accent-vivid); border-radius: var(--radius-lg); text-decoration: none; transition: border-color var(--dur-fast); }
  .proof-strip:hover { border-color: rgba(0,230,118,0.4); }
  .proof-metric { font-size: 26px; font-weight: 700; color: #FFF; white-space: nowrap; letter-spacing: -0.01em; line-height: 1.1; }
  .proof-metric .pa { color: var(--color-accent-vivid); margin: 0 2px; }
  .proof-metric small { display: block; font-family: var(--font-mono); font-size: 10px; font-weight: 400; color: var(--fg-3); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 6px; }
  .proof-copy { font-size: 14px; color: var(--fg-2); line-height: 1.6; }
  .proof-go { font-size: 13px; font-weight: 600; color: var(--fg-1); white-space: nowrap; }
  .proof-strip:hover .proof-go { color: var(--color-accent-vivid); }
  @media (max-width: 680px) { .proof-strip { grid-template-columns: 1fr; gap: 14px; } .proof-go { justify-self: start; } }

  /* Headshot frame */
  .headshot-frame {
    position: relative; aspect-ratio: 3/4;
    border-radius: 14px;
    background: linear-gradient(135deg, #0F172A 0%, #0A2540 60%, #050B17 100%);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0,230,118,0.08);
  }
  .headshot-frame img {
    width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block;
  }
  .headshot-frame .corner {
    position: absolute; padding: 10px 12px; font-family: var(--font-mono);
    font-size: 9px; color: rgba(148,163,184,0.7); letter-spacing: 0.1em; text-transform: uppercase;
    z-index: 2;
  }
  .headshot-frame .corner.tl { top: 0; left: 0; }
  .headshot-frame .corner.br { bottom: 0; right: 0; color: var(--color-accent-vivid); text-align: right; }
  /* Scan line — purely decorative, echoes the bio page portrait treatment */
  .headshot-frame .scan {
    position: absolute; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, transparent, rgba(0,230,118,0.35), transparent);
    animation: scandown 7s linear infinite;
    z-index: 1; pointer-events: none;
  }
  @keyframes scandown {
    0%   { top: 0%; opacity: 0; }
    5%   { opacity: 1; }
    95%  { opacity: 0.6; }
    100% { top: 100%; opacity: 0; }
  }

  .home-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: center; }

  /* Stats strip */
  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: var(--border-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-top: 64px;
  }
  .stats .stat { background: var(--bg-base); padding: 28px 24px; }
  .stats .stat.key .v { color: var(--color-accent-vivid); }
  .stats .stat.key .l { color: var(--fg-1); }
  .stats .v {
    font-size: 38px; font-weight: 700; line-height: 1;
    letter-spacing: -0.01em; color: #FFF; font-variant-numeric: tabular-nums;
    display: flex; align-items: baseline; gap: 6px;
  }
  .stats .v small { font-size: 16px; font-weight: 500; color: var(--fg-2); }
  .stats .l { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-2); margin-top: 12px; }

  /* Work with me */
  section.block { padding: 96px 0; }
  .offer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .offer-card {
    display: flex; flex-direction: column; padding: 28px 26px;
    text-decoration: none; color: inherit;
  }
  .offer-card:hover { border-color: rgba(0,230,118,0.4); background: rgba(30,41,59,0.85); }
  .offer-card .kind {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-accent-vivid); margin-bottom: 14px;
  }
  .offer-card h3 { font-size: 19px; font-weight: 600; line-height: 1.3; margin: 0 0 10px; color: #FFF; letter-spacing: -0.01em; }
  .offer-card p { font-size: 14px; color: var(--fg-2); line-height: 1.65; margin: 0 0 22px; }
  .offer-card .go {
    margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border-subtle);
    font-size: 13px; font-weight: 600; color: var(--fg-1);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .offer-card:hover .go { color: var(--color-accent-vivid); }
  .offer-note { margin: 28px 0 0; font-size: 14px; color: var(--fg-2); line-height: 1.9; }
  .offer-note .live-pill { margin-right: 10px; vertical-align: 2px; }
  .offer-note a { color: var(--fg-1); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--border-strong); }
  .offer-note a:hover { color: var(--color-accent-vivid); border-bottom-color: var(--color-accent-vivid); }


  #work .page-wrap { position: relative; }
  #work .egg-link {
    position: absolute; top: 8px; right: 8px;
    font-family: var(--font-mono); font-size: 11px;
    color: var(--fg-3); opacity: 0.35;
    text-decoration: none; line-height: 1;
    transition: color var(--dur-fast) var(--ease-standard), opacity var(--dur-fast) var(--ease-standard);
  }
  #work .egg-link:hover { opacity: 1; color: var(--color-accent-vivid); cursor: pointer; }
  section.block .block-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; gap: 32px; flex-wrap: wrap; }
  section.block h2 { font-size: 38px; font-weight: 700; line-height: 1.1; letter-spacing: -0.01em; margin: 0; max-width: 600px; }
  section.block .block-sub { color: var(--fg-2); font-size: 15px; max-width: 480px; line-height: 1.6; margin-top: 12px; }

  /* Three-acts escalation: a connecting line behind the row + rising accent */
  .work-arc { position: relative; }
  .work-connector {
    position: absolute; top: 34px; left: 0; right: 0; height: 1px; z-index: 0;
    background: linear-gradient(90deg, var(--border-subtle) 10%, rgba(0,230,118,0.45));
  }
  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; position: relative; z-index: 1; }
  .work-card { position: relative; z-index: 0; overflow: hidden; padding: 24px; }
  .work-card.act-2 { border-color: rgba(0,230,118,0.28); }
  .work-card.act-3 {
    border-color: rgba(0,230,118,0.4);
    background: linear-gradient(180deg, var(--bg-card) 0%, rgba(0,230,118,0.05) 170%);
  }
  .work-card .node { width: 11px; height: 11px; border-radius: 50%; flex-shrink: 0; box-sizing: border-box; }
  .work-card.act-1 .node { border: 1px solid var(--border-strong); }
  .work-card.act-2 .node { border: 1px solid rgba(0,230,118,0.5); background: rgba(0,230,118,0.15); }
  .work-card.act-3 .node { border: 1px solid var(--color-accent-vivid); background: var(--color-accent-vivid); }
  .work-card.act-2 .era, .work-card.act-3 .era { color: var(--color-accent-vivid); border-color: rgba(0,230,118,0.4); }
  .work-card .bg-num {
    position: absolute; top: -16px; right: -4px; z-index: -1;
    font-family: var(--font-mono); font-size: 88px; font-weight: 700;
    line-height: 1; letter-spacing: -0.04em; color: var(--fg-1); opacity: 0.05;
    pointer-events: none; user-select: none;
  }
  .work-card .ix { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; color: var(--fg-3); letter-spacing: 0.08em; margin-bottom: 10px; }
  .work-card .era { display: inline-block; font-size: 10px; font-family: var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2); border: 1px solid var(--border-strong); border-radius: 999px; padding: 3px 9px; margin-bottom: 14px; }
  .work-card h3 { font-size: 18px; font-weight: 500; line-height: 1.3; margin: 0 0 8px; color: #FFF; }
  .work-card p { font-size: 13px; color: var(--fg-2); margin: 0 0 18px; line-height: 1.6; }
  .work-card .meta { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--fg-3); padding-top: 14px; border-top: 1px solid var(--border-subtle); }
  .work-card .meta .role { color: var(--fg-1); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }

  /* Writing teaser */
  .post-list { display: flex; flex-direction: column; }
  .post-row {
    display: grid; grid-template-columns: 88px 1fr 140px 28px;
    gap: 24px; padding: 20px 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: center; cursor: pointer; text-decoration: none;
    transition: padding-left var(--dur-base) var(--ease-standard);
  }
  .post-row:hover { padding-left: 12px; }
  .post-row .date { font-family: var(--font-mono); font-size: 11px; color: var(--fg-3); letter-spacing: 0.08em; text-transform: uppercase; }
  .post-row .title { font-size: 17px; font-weight: 500; color: #FFF; }
  .post-row .title .read { font-size: 11px; color: var(--fg-3); margin-left: 10px; font-family: var(--font-mono); }
  .post-row .tag { font-size: 11px; color: var(--fg-3); text-transform: uppercase; letter-spacing: 0.08em; text-align: right; }
  .post-row .arrow { color: var(--fg-3); transition: color var(--dur-fast); }
  .post-row:hover .arrow { color: var(--color-accent-vivid); }

  /* Podcast band */
  .podcast-grid { display: grid; grid-template-columns: 1fr 0.9fr; gap: 48px; align-items: center; }
  .podcast-plate {
    position: relative; border: 1px solid var(--border-subtle); border-radius: 14px;
    overflow: hidden; background: var(--bg-deep);
    box-shadow: 0 40px 80px -40px rgba(0,230,118,0.14);
  }
  .podcast-plate img { width: 100%; height: auto; display: block; }
  .podcast-copy h2 { font-size: clamp(28px, 3.4vw, 38px); font-weight: 700; line-height: 1.12; letter-spacing: -0.01em; margin: 16px 0 14px; max-width: 16ch; }
  .podcast-copy .tagline { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--fg-1); margin: 0 0 14px; }
  .podcast-copy p { font-size: 15px; color: var(--fg-2); line-height: 1.7; margin: 0 0 24px; max-width: 46ch; }

  @media (max-width: 900px) {
    .podcast-grid { grid-template-columns: 1fr; gap: 28px; }
    .home-grid { grid-template-columns: 1fr; }
    .headshot-frame { max-width: 320px; aspect-ratio: 3/4; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .work-connector { display: none; }
    .work-grid, .offer-grid { grid-template-columns: 1fr; }
    .post-row { grid-template-columns: 80px 1fr 28px; }
    .post-row .tag { display: none; }
  }
</style>
