  .tools-hero .lede + .lede { margin-top: 12px; }
  .tools-count { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin: 0 0 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border-subtle); }
  .tools-count .l { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-2); }
