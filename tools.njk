  .tools-hero { padding: 80px 0 40px; max-width: 720px; }
  .tools-hero h1 { font-size: clamp(40px, 6vw, 64px); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0 16px; }
