<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — Jason Nellis</title>
<meta name="description" content="{{ hook }}">
{%- set shareImage = ogImage or "/og-image-speaking.png" %}
<!-- Open Graph / Twitter -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://jasonnellis.com{{ page.url }}">
<meta property="og:title" content="{{ title }} — Jason Nellis">
<meta property="og:description" content="{{ hook }}">
<meta property="og:image" content="https://jasonnellis.com{{ shareImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} — Jason Nellis">
<meta name="twitter:description" content="{{ hook }}">
<meta name="twitter:image" content="https://jasonnellis.com{{ shareImage }}">
<link rel="canonical" href="https://jasonnellis.com{{ page.url }}">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="stylesheet" href="/site.css">
<style>
  /* Talk pages run without section eyebrows or field labels: plain h2s. */
  .talk-header { padding: 72px 0 8px; max-width: 720px; }
  .talk-header .back-link { font-size: 13px; display: inline-block; margin-bottom: 22px; }
  .talk-header h1 {
    font-size: clamp(32px, 5vw, 48px); font-weight: 700;
    line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 16px;
  }
  .talk-header .hook { font-size: 19px; line-height: 1.55; color: var(--fg-1); margin: 0 0 12px; }
  .talk-header .fit { font-size: 14px; line-height: 1.6; color: var(--fg-3); margin: 0; }

  /* Stage photo, chosen per talk via `stagePhoto` front matter. The navy
     background holds the 3:2 box if the file ever fails to load. */
  .talk-photo { max-width: 720px; margin: 32px 0 0; }
  .talk-photo img {
    display: block; width: 100%; height: auto; aspect-ratio: 3 / 2;
    object-fit: cover; object-position: center 35%;
    border-radius: var(--radius-lg); border: 1px solid var(--border-subtle);
    background: var(--bg-deep);
  }
  .talk-photo figcaption { margin-top: 10px; font-size: 13px; line-height: 1.5; color: var(--fg-3); }

  .talk-body { max-width: 720px; padding: 24px 0 0; }
  .talk-body p { font-size: 17px; line-height: 1.75; color: var(--fg-2); margin: 0 0 18px; }

  .talk-section { max-width: 720px; margin: 44px 0 0; }
  .talk-section h2 { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 16px; }

  .takeaways { margin: 0; padding-left: 20px; }
  .takeaways li { font-size: 16px; color: var(--fg-2); line-height: 1.6; margin-bottom: 6px; }

  .talk-arc { margin: 0; padding-left: 22px; }
  .talk-arc li { font-size: 15px; color: var(--fg-3); padding-left: 4px; margin-bottom: 14px; }
  .talk-arc .arc-title { color: var(--fg-1); font-weight: 600; font-size: 16px; margin: 0 0 2px; }
  .talk-arc .arc-body { color: var(--fg-2); font-size: 15px; line-height: 1.6; margin: 0; }

  .talk-evidence { list-style: none; padding: 0; margin: 0; }
  .talk-evidence li { padding: 16px 0; border-top: 1px solid var(--border-subtle); }
  .talk-evidence li:first-child { border-top: none; padding-top: 0; }
  .talk-evidence .ev-label { color: var(--fg-1); font-weight: 600; font-size: 15px; }
  .talk-evidence .ev-body { color: var(--fg-2); font-size: 15px; line-height: 1.6; margin: 4px 0 0; }
  .talk-evidence .ev-link { font-size: 13px; margin-top: 6px; display: inline-block; }

  .talk-related { max-width: 720px; margin: 32px 0 0; font-size: 15px; color: var(--fg-2); }

  .talk-footer {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    max-width: 720px; margin: 32px 0 96px; padding-top: 24px; border-top: 1px solid var(--border-subtle);
  }
  .talk-footer p { font-size: 15px; color: var(--fg-2); margin: 0; }
</style>
<script src="/nav.js"></script>
</head>
<body class="bolt-os">

<a href="#main" class="skip-link">Skip to main content</a>

<site-header></site-header>

<main class="atmos" data-screen-label="talk" id="main">
  <div class="page-wrap page-wrap--narrow">
    <div class="talk-header">
      <a href="/speaking" class="bolt back-link">← All talks</a>
      <h1>{{ title }}</h1>
      <p class="hook">{{ hook }}</p>
      <p class="fit">{{ length }}. For {{ bestFor }}.</p>
    </div>

    {#- Fallback: the square IFA stage shot, for any talk without its own photo. #}
    {%- set photo = stagePhoto or {
      "src": "/jason-nellis-headshot-stage.jpg", "width": 1199, "height": 1200,
      "alt": "Jason Nellis speaking on a panel at IFA 2026 in Berlin, microphone in hand",
      "caption": "IFA Berlin, 2026"
    } %}
    <figure class="talk-photo">
      <img src="{{ photo.src }}" alt="{{ photo.alt | escape }}" width="{{ photo.width }}" height="{{ photo.height }}" decoding="async">
      {%- if photo.caption %}
      <figcaption>{{ photo.caption | escape }}</figcaption>
      {%- endif %}
    </figure>

    <div class="talk-body">
      {{ content | safe }}
    </div>

    <div class="talk-section">
      <h2>What the room leaves with</h2>
      <ul class="takeaways">
        {%- for t in takeaways %}
        <li>{{ t }}</li>
        {%- endfor %}
      </ul>
    </div>

    {%- if narrativeArc %}
    <div class="talk-section">
      <h2>How it runs</h2>
      <ol class="talk-arc">
        {%- for section in narrativeArc %}
        <li>
          <p class="arc-title">{{ section.title }}</p>
          <p class="arc-body">{{ section.body }}</p>
        </li>
        {%- endfor %}
      </ol>
    </div>
    {%- endif %}

    {%- if evidence %}
    <div class="talk-section">
      <h2>Where it comes from</h2>
      <ul class="talk-evidence">
        {%- for item in evidence %}
        <li>
          <div class="ev-label">{{ item.label }}</div>
          <p class="ev-body">{{ item.body }}</p>
          {%- if item.url %}
          <a class="bolt ev-link" href="{{ item.url }}">Read more<span class="sr-only"> about {{ item.label }}</span> →</a>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}

    {%- if relatedEssaySlug %}
    <p class="talk-related">Related reading: <a class="bolt" href="/blog/{{ relatedEssaySlug }}/">{{ relatedEssayTitle }}</a></p>
    {%- endif %}

    <div class="talk-footer">
      <p>I shape every talk to the room and the run of show.</p>
      <a href="/contact?topic=speaking&amp;talk={{ page.fileSlug }}&amp;talkTitle={{ title | urlencode }}" class="btn primary">Book this talk</a>
    </div>
  </div>
</main>

<site-footer></site-footer>

</body>
</html>
