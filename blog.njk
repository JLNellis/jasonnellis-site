<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Writing — Jason Nellis</title>
<meta name="description" content="Essays and reflections from Jason Nellis on strategy, media, technology, and the creator economy.">
<!-- Open Graph / Twitter -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://jasonnellis.com/blog">
<meta property="og:title" content="Writing — Jason Nellis">
<meta property="og:description" content="Essays and reflections from Jason Nellis on strategy, media, technology, and the creator economy.">
<meta property="og:image" content="https://jasonnellis.com/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Writing — Jason Nellis">
<meta name="twitter:description" content="Essays and reflections from Jason Nellis on strategy, media, technology, and the creator economy.">
<meta name="twitter:image" content="https://jasonnellis.com/og-image.png">
<link rel="canonical" href="https://jasonnellis.com/blog">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/atom+xml" title="Jason Nellis — Writing" href="/feed.xml">
<link rel="stylesheet" href="/site.css">
<style>
  .blog-hero {
    padding: 80px 0 32px;
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: center;
  }
  .blog-hero h1 { font-size: clamp(40px, 6vw, 64px); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0 16px; }
  .blog-hero .lede { font-size: 18px; line-height: 1.6; color: var(--fg-2); max-width: 560px; margin: 0 0 24px; }
  .hero-lens { font-size: 14px; line-height: 1.6; color: var(--fg-2); max-width: 560px; margin: -8px 0 24px; }
  .hero-lens a { color: var(--color-accent-vivid); text-decoration: none; font-weight: 600; }
  .hero-lens a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Hero photo */
  .hero-photo {
    position: relative; aspect-ratio: 3/4; max-width: 300px;
    border-radius: 14px; overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: linear-gradient(135deg, #0F172A 0%, #0A2540 60%, #050B17 100%);
    justify-self: end;
  }
  .hero-photo img {
    width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block;
  }

  .filter-bar {
    scroll-margin-top: 88px;
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    padding: 14px 16px;
    background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 10px;
    margin-bottom: 32px;
  }
  .filter-bar .l { font-size: 13px; color: var(--fg-2); margin-right: 8px; }
  .filter-bar .chip {
    font-size: 12px; padding: 5px 11px; border-radius: 999px;
    border: 1px solid var(--border-strong); color: var(--fg-2); cursor: pointer; background: transparent;
    transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
    font-family: var(--font-sans); font-weight: 500;
  }
  .filter-bar .chip:hover { color: var(--fg-1); border-color: var(--fg-2); }
  .filter-bar .chip.active { color: var(--color-accent-vivid); border-color: var(--color-accent-vivid); background: rgba(0,230,118,0.08); }
  @media (pointer: coarse) { .filter-bar .chip { padding: 9px 13px; } }
  .filter-bar .count { margin-left: auto; font-size: 13px; color: var(--fg-3); font-variant-numeric: tabular-nums; }

  /* Featured post */
  .featured {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px;
    padding: 36px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle); border-radius: 14px;
    margin-bottom: 48px; position: relative; overflow: hidden;
  }
  .featured h2 { font-size: 32px; font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; margin: 14px 0 14px; }
  .featured p { color: var(--fg-2); font-size: 15px; line-height: 1.65; margin: 0 0 22px; }
  .featured .meta { display: flex; gap: 16px; align-items: center; font-size: 11px; color: var(--fg-3); font-family: var(--font-mono); }
  .featured .meta .tag { font-family: var(--font-sans); font-size: 13px; color: var(--fg-2); }
  .featured-art {
    background: var(--bg-deep); border: 1px solid var(--border-subtle); border-radius: 10px;
    position: relative; overflow: hidden; min-height: 240px;
    display: flex; align-items: center; justify-content: center;
  }
  .featured-art svg { opacity: 0.15; }
  .featured-art img { width: 100%; height: 100%; object-fit: cover; }

  /* Post list */
  .posts { display: flex; flex-direction: column; }
  .post-row {
    display: grid; grid-template-columns: 96px 1fr 140px 110px 28px;
    gap: 24px; padding: 22px 0; align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    transition: opacity var(--dur-fast);
  }
  .post-row:hover .arrow { color: var(--color-accent-vivid); transform: translateX(2px); }
  .post-row .arrow { transition: transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard); color: var(--fg-3); font-size: 18px; text-align: right; }
  .post-row .date { font-family: var(--font-mono); font-size: 11px; color: var(--fg-3); }
  .post-row .title { font-size: 17px; font-weight: 500; color: #FFF; line-height: 1.4; }
  .post-row .title .desc { display: block; font-size: 13px; color: var(--fg-2); font-weight: 400; margin-top: 4px; line-height: 1.55; }
  .post-row .tag { font-size: 13px; color: var(--fg-3); }
  .post-row .read { font-size: 11px; color: var(--fg-3); font-family: var(--font-mono); text-align: right; }

  @media (max-width: 880px) {
    .blog-hero { grid-template-columns: 1fr; gap: 24px; }
    .hero-photo { max-width: 240px; justify-self: start; order: -1; }
    .featured { grid-template-columns: 1fr; }
    .post-row { grid-template-columns: 88px 1fr 28px; }
    .post-row .tag, .post-row .read { display: none; }
  }
  /* .subscribe-banner styles now live in site.css (shared with the homepage) */
</style>
<script src="/nav.js"></script>
</head>
<body class="bolt-os">

<a href="#main" class="skip-link">Skip to main content</a>

<site-header></site-header>

<main class="atmos" data-screen-label="01 blog" id="main">
  <section>
    <div class="page-wrap">
      <div class="blog-hero">
        <div>
          <h1>Notes from inside the creator economy.</h1>
          <p class="lede">Essays and case studies, written from the south of France.</p>
          <p class="hero-lens">Start with a framework: <a href="/lens">The Lens, on whether a creator is building something or renting attention</a></p>
        </div>
        <div class="hero-photo">
          <img class="stage-photo" src="/jason-nellis-stage-3x4-600.jpg" alt="Jason Nellis speaking on a panel at IFA Berlin, microphone in hand" width="600" height="800">
        </div>
      </div>

      <!-- BUILDING VALUE PODCAST NOTIFY BANNER -->
      <div class="subscribe-banner">
        <div class="sub-content">
          <p class="sub-headline"><em>Building Value</em> is relaunching.</p>
          <p class="sub-body">The podcast on how creative work becomes a business, back in Q4 2026 with a new look. Leave your email and I'll tell you when it's back.</p>
          <form class="sub-form" action="https://app.kit.com/forms/9920578/subscriptions" method="post" target="_blank">
            <input type="email" name="email_address" placeholder="your@email.com" required class="sub-input" autocomplete="email" aria-label="Email address">
            <button type="submit" class="btn primary sub-btn">Get notified</button>
          </form>
          <p class="sub-note">Powered by Kit &middot; Unsubscribe anytime</p>
        </div>
      </div>

      {%- set featured = collections.essays[0] %}

      <!-- Filter bar -->
      <div class="filter-bar">
        <span class="l">Filter</span>
        <button class="chip active" aria-pressed="true" data-cat="all" onclick="filterPosts(this)">All</button>
        {%- for cat in collections.essays | sharedCategories %}
        <button class="chip" aria-pressed="false" data-cat="{{ cat }}" onclick="filterPosts(this)">{{ cat | capitalize }}</button>
        {%- endfor %}
        <span class="count" id="post-count" aria-live="polite">{{ collections.essays.length }} essays</span>
      </div>

      <!-- Featured post -->
      <div class="featured" data-cat="{{ featured.data.category }}">
        <div>
          <div class="meta"><span class="tag">{{ featured.data.category | capitalize }}</span><span>{{ featured.data.date | readableDate }}</span><span>{{ featured.data.readTime }}</span></div>
          <h2>{{ featured.data.title }}</h2>
          <p>{{ featured.data.description }}</p>
          <a href="{{ featured.url }}" class="btn primary">Read essay →</a>
        </div>
        <div class="featured-art">
          {%- if featured.data.heroImage %}
          <img src="{{ featured.data.heroImage }}" alt="{{ featured.data.title }}" width="1400" height="788" loading="lazy">
          {%- else %}
          <svg aria-hidden="true" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l2 2 4-4"/></svg>
          {%- endif %}
        </div>
      </div>

      <!-- Posts -->
      <div class="posts">
        {%- for essay in collections.essays %}
        {%- if essay.url != featured.url %}
        <a class="post-row" href="{{ essay.url }}" data-cat="{{ essay.data.category }}">
          <span class="date">{{ essay.data.date | readableDate }}</span>
          <span class="title">{{ essay.data.title }}<span class="desc">{{ essay.data.description }}</span></span>
          <span class="tag">{{ essay.data.category | capitalize }}</span>
          <span class="read">{{ essay.data.readTime }}</span>
          <span class="arrow">→</span>
        </a>
        {%- endif %}
        {%- endfor %}
      </div>
    </div>
  </section>
</main>

<site-footer></site-footer>

<script>
function filterPosts(btn) {
  document.querySelectorAll('.filter-bar .chip').forEach(c => {
    c.classList.toggle('active', c === btn);
    c.setAttribute('aria-pressed', String(c === btn));
  });
  const cat = btn.dataset.cat;
  let count = 0;
  document.querySelectorAll('.posts .post-row, .featured').forEach(el => {
    const match = cat === 'all' || el.dataset.cat === cat;
    el.style.display = match ? '' : 'none';
    if (match) count++;
  });
  document.getElementById('post-count').textContent = count + (count === 1 ? ' essay' : ' essays');
}
// /blog#case-study opens with that category selected (slug of the chip label).
(function () {
  const slug = location.hash.slice(1);
  if (!slug) return;
  const chip = [...document.querySelectorAll('.filter-bar .chip')]
    .find(c => c.dataset.cat.toLowerCase().replace(/\s+/g, '-') === slug);
  if (!chip) return;
  filterPosts(chip);
  // Land on the filtered list itself, past the hero and the podcast banner.
  // Wait for load so images above it have their final height.
  const land = () => document.querySelector('.filter-bar').scrollIntoView({ block: 'start', behavior: 'instant' });
  if (document.readyState === 'complete') land(); else window.addEventListener('load', land);
})();
</script>

</body>
</html>
